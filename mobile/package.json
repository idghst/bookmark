{
  "name": "bookmark-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.16",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --host lan",
    "android": "adb reverse tcp:8081 tcp:8081 >/dev/null 2>&1 || true; NODE_OPTIONS=--dns-result-order=ipv4first expo start --android --host lan",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --ios --host lan",
    "web": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --web --host lan",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts && pnpm --dir .. exec vitest run --config mobile/vitest.config.ts",
    "check": "expo install --check",
    "doctor": "expo-doctor",
    "release": "./script/release.sh"
  },
  "private": true,
  "packageManager": "pnpm@11.1.0"
}
